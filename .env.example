# Copy to .env in the repo root before running `docker compose up -d`.
# Never commit the real .env.

# --- required -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-secret

# --- database (defaults are fine for local/demo use) -------------------------
POSTGRES_PASSWORD=detectai

# --- AI provider (optional — "none" is fully functional, see docs/ARCHITECTURE.md §13) ---
AI_PROVIDER=none
# AI_PROVIDER=ollama
# AI_MODEL=llama3
# AI_BASE_URL=http://ollama:11434   # note: container hostname, not localhost, when using the ollama profile

# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# AI_API_KEY=sk-ant-...

# --- frontend build-time config -------------------------------------------
# Must be the URL the BROWSER can reach — not a docker-network hostname.
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1
