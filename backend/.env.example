# Copy this to .env and fill in real values. Never commit the real .env.

# --- app ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- security ------------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# --- database ------------------------------------------------------------
# Real Postgres (requires a running Postgres instance — see docker-compose.yml, Phase 25):
DATABASE_URL=postgresql+asyncpg://detectai:detectai@localhost:5432/detectai
# Local dev without Postgres running (uses sqlite instead):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- AI provider ---------------------------------------------------------
# "none" = rule-based scoring only, no LLM calls at all (fully functional).
AI_PROVIDER=none
# AI_PROVIDER=ollama
# AI_MODEL=llama3
# AI_BASE_URL=http://localhost:11434

# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# AI_API_KEY=sk-ant-...
